{
  "name": "@vercel/style-guide",
  "version": "6.0.0",
  "description": "Vercel's engineering style guide",
  "homepage": "https://github.com/vercel/style-guide#readme",
  "bugs": {
    "url": "https://github.com/vercel/style-guide/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/style-guide.git"
  },
  "license": "MPL-2.0",
  "exports": {
    "./eslint/*": "./eslint/*.js",
    "./eslint/flat": "./eslint/flat/index.js",
    "./prettier": "./prettier/index.js",
    "./typescript": "./typescript/tsconfig.base.json",
    "./typescript/node20": "./typescript/tsconfig.node20.json",
    "./typescript/node22": "./typescript/tsconfig.node22.json"
  },
  "main": "index.js",
  "files": [
    "eslint",
    "prettier",
    "typescript"
  ],
  "scripts": {
    "eslint-check": "eslint --max-warnings=0 .",
    "outdated": "bunx npm-check-updates --root --format group -i -p pnpm",
    "prettier-check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "lint-staged": {
    "*": "prettier -w --ignore-unknown"
  },
  "prettier": "./prettier",
  "dependencies": {
    "@babel/core": "^7.28.3",
    "@babel/eslint-parser": "^7.28.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/js": "^9.33.0",
    "@rushstack/eslint-patch": "^1.12.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/eslint-plugin": "^1.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-testing-library": "^7.6.6",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "globals": "^16.3.0",
    "prettier-plugin-packagejson": "^2.5.19",
    "typescript-eslint": "^8.39.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@next/eslint-plugin-next": ">=12.3.0 <16",
    "eslint": ">=8.57.0 <10",
    "prettier": ">=3.0.0 <4",
    "typescript": ">=4.8.0 <6"
  },
  "peerDependenciesMeta": {
    "@next/eslint-plugin-next": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  }
}
